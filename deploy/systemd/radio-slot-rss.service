[Unit]
Description=Radio appliance news slot (mario-slot rss)
Documentation=https://github.com/The-Replacement/docs/blob/main/autonomy/02-design.md
After=docker.service radio-batch.slice

[Service]
Type=oneshot
User=kbdejavu
WorkingDirectory=/home/kbdejavu/servers/radio
ExecStart=/home/kbdejavu/servers/radio/scripts/mario-slot.sh rss
Nice=10
IOSchedulingClass=best-effort
TimeoutStartSec=10min