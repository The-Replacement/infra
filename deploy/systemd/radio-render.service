[Unit]
Description=Radio appliance generator cycle (radio-job render)
Documentation=https://github.com/The-Replacement/docs/blob/main/autonomy/02-design.md
After=docker.service radio-batch.slice

[Service]
Type=oneshot
User=kbdejavu
WorkingDirectory=/home/kbdejavu/servers/radio
ExecStart=/home/kbdejavu/servers/radio/scripts/radio-job.sh render
Nice=10
IOSchedulingClass=best-effort
TimeoutStartSec=30min